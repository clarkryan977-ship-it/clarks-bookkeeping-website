# Copy this file to .env when running locally, or set these as variables in Railway.

# Postgres connection string. On Railway, attach a Postgres add-on and reference it as:
#   ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:password@host:5432/dbname

# Random string used to sign JWT session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Directory where uploaded client documents are stored.
# On Railway, attach a Volume mounted at /app/uploads for persistence.
UPLOAD_DIR=/app/uploads

# Port (Railway sets this automatically; leave unset locally to use 3000)
# PORT=3000
